# gost-run.service — пример юнита клиента туннеля (GOST v3). GOST и этот юнит
# ставятся вручную (install.sh и роль Ansible их не трогают):
#   sudo install -m 0644 gost-run.service /etc/systemd/system/
# Удалённые узлы — docs/TUNNEL.md.
#
# Слушатель — под VPN_MODE в router.conf (порт — VPN_PORT):
#   redirect  -L red://:1080
#   tproxy    -L red://:1080?tproxy=true -L redu://:1080?ttl=30s
#   route     -L tun://:0/127.0.0.1:8421?net=192.168.123.2/24&name=tun0
# Цепочка -F — входной узел: TLS + HTTP с авторизацией. secure=true — проверять
# сертификат сервера (без него GOST принимает любой).
[Unit]
Description=GOST — клиент туннеля
After=network-online.target
Wants=network-online.target
# Без ограничения частоты запусков (по умолчанию 5 за 10 с): после серии
# перезапусков сервис шлюза не должен оставаться остановленным.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/gost -L red://:1080 -F https://user:password@vpn.example.com:443?secure=true
Restart=on-failure
RestartSec=5
DynamicUser=yes
# tproxy (IP_TRANSPARENT) и route (создание tun) требуют CAP_NET_ADMIN;
# tproxy для UDP отвечает клиенту с исходного адреса и порта (например, :53) —
# CAP_NET_BIND_SERVICE.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
