[Unit]
Description=routerd-web — веб-интерфейс routerd
Documentation=https://github.com/volkserg/rpi5-gorouter
# Без демона интерфейс работает и показывает, что routerd недоступен.
After=network-online.target routerd.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/routerd web serve
Restart=on-failure
RestartSec=3
# Отдельный пользователь без прав: сервис только проверяет вход и передаёт
# запросы демону через /run/routerd/api.sock (доступен группе routerd-web).
User=routerd-web
Group=routerd-web
# /var/lib/routerd-web — ключ сессий и самоподписанный сертификат.
StateDirectory=routerd-web
StateDirectoryMode=0700

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
