[Unit]
Description=routerd — шлюз LAN: NAT, DNS-фильтр, маршрутизация по спискам
Documentation=https://github.com/volkserg/rpi5-gorouter
After=network-online.target
Wants=network-online.target
# Без ограничения частоты запусков (по умолчанию 5 за 10 с): после серии
# перезапусков сервис шлюза не должен оставаться остановленным.
StartLimitIntervalSec=0

[Service]
# notify-reload: systemd шлёт SIGHUP и ждёт READY=1 — reload-vpn-domains
# завершается, только когда routerd действительно применил списки.
Type=notify-reload
ExecStart=/usr/local/bin/routerd run
Restart=on-failure
RestartSec=3
# /var/lib/routerd — аренды DHCP (leases.json).
StateDirectory=routerd
# /run/routerd/api.sock — API для веб-интерфейса (группа routerd-web).
RuntimeDirectory=routerd
RuntimeDirectoryMode=0755
# Сверка ключей цепочки DNS в pihole.toml (PIHOLE_MANAGE).
ReadWritePaths=-/etc/pihole

# Права: root нужен для управления юнитами по D-Bus, остальное урезано.
# CAP_DAC_OVERRIDE, CAP_CHOWN, CAP_FOWNER — только для атомарной правки
# /etc/pihole/pihole.toml (каталог и файл принадлежат пользователю pihole).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
